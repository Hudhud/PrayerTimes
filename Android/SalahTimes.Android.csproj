<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <RootNamespace>SalahTimes.AndroidApp</RootNamespace>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationId>dk.salahtimes.android</ApplicationId>
    <ApplicationTitle>Salah Times</ApplicationTitle>
    <ApplicationVersion>15</ApplicationVersion>
    <ApplicationDisplayVersion>1.5.4</ApplicationDisplayVersion>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Release'">aab;apk</AndroidPackageFormats>
    <AndroidPackageFormats Condition="'$(AndroidPackageFormats)' == ''">apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Calculation/Calculation.csproj" />
    <AndroidAsset Include="../Web/wwwroot/data/prayer-places.json" Link="Assets/prayer-places.json" />
    <AndroidAsset Include="../Web/wwwroot/data/prayer-cities-world.json" Link="Assets/prayer-cities-world.json" />
  </ItemGroup>
</Project>
