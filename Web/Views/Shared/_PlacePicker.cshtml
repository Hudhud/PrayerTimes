@model string
<div class="place-picker" data-place-picker>
    <label for="place-query">By eller postnummer</label>
    <div class="place-controls">
        <form method="get" asp-controller="Home" asp-action="Places" class="place-search" role="search"
              data-suggestions="@Url.Action("PlaceSuggestions", "Home")">
            <div class="place-search-field">
                <input id="place-query" name="q" type="search" value="@Model" placeholder="Fx Aarhus eller 8000"
                       maxlength="80" required autocomplete="off" />
                <div class="place-suggestions">
                    <ul id="place-suggestions" role="listbox" aria-label="Stedforslag" hidden></ul>
                    <p class="place-search-status visually-hidden" role="status"></p>
                </div>
            </div>
            <button class="button place-search-button" type="submit">Søg</button>
        </form>
        <button class="button location-button" type="button" data-use-location
                data-catalog="@Url.Content("~/data/prayer-places.json")" data-place-base="@Url.Content("~/")"
                hidden>Brug min placering</button>
    </div>
    <p class="location-status" data-location-status role="status"></p>
</div>
