@model Web.ViewModels.CalendarViewModel
@using Application.Calendars
@using System.Globalization
@using Web.ViewModels
@{
    var danish = CultureInfo.GetCultureInfo("da-DK");
    var month = CalendarViewModel.MonthParameter(Model.Month);
    var monthName = Model.Month.ToString("MMMM yyyy", danish);
    var hasMonth = Model.Days.Count > 0;
    var completeMonth = Model.Days.Count == DateTime.DaysInMonth(Model.Month.Year, Model.Month.Month);
}
<section class="month" id="month-title" aria-label="Bønnekalender">
    <h2 id="calendar-month-heading">@monthName</h2>
    <nav class="calendar-nav" aria-label="Vælg måned">
        <partial name="_CalendarMonthLinks" model="Model" />
    </nav>
    <p class="print-city">@Model.City.Name · Dansk lokal tid · Asr @(Model.Hanafi ? "Hanafi" : "standard")</p>
    @if (!hasMonth)
    {
        <p>Månedsoversigten er midlertidigt utilgængelig.</p>
    }
    else
    {
        <details class="calendar-options">
            <summary>@(completeMonth ? "Udskriv og eksportér" : "Udskriv")</summary>
            <div class="calendar-actions">
                <button class="button print-button" type="button" data-print hidden>Udskriv</button>
                @if (completeMonth)
                {
                    <a class="button" asp-route="CalendarExport" asp-route-city="@Model.City.Slug"
                       asp-route-month="@month">Hent kalenderfil</a>
                }
            </div>
        </details>
        @if (!completeMonth)
        {
            <p>Månedsoversigten er ufuldstændig. Nogle datoer mangler.</p>
        }
        <div class="mobile-calendar month-days">
            @foreach (var day in Model.Days)
            {
                var date = DateOnly.FromDateTime(day.Date);
                var dayParameter = CalendarViewModel.DayParameter(date);
                var isToday = date == Model.Today;
                <details class="month-day @(isToday ? "current-day" : null)" name="calendar-days"
                         data-calendar-date="@dayParameter" data-today-anchor="week-today"
                         id="@(isToday ? "week-today" : null)" open="@(date == Model.SelectedDate)" tabindex="-1">
                    <summary>
                        <time datetime="@dayParameter">@date.ToString("dddd d. MMMM", danish)</time>
                        <small data-today-label hidden="@(!isToday)">I dag</small>
                    </summary>
                    <div class="month-day-times">
                        <partial name="_PrayerList" model="new PrayerListViewModel(day, Model.Hanafi, ShowSunrise: true, ExplainBrightNights: true)" />
                    </div>
                </details>
            }
        </div>
        <div class="table-scroll desktop-calendar" role="region" aria-labelledby="calendar-month-heading" tabindex="0">
            <table>
                <caption>Bønnetider i @Model.City.Name · @monthName · Dansk lokal tid</caption>
                <thead>
                    <tr>
                        <th scope="col">Dato</th>
                        <th scope="col">Fajr</th>
                        <th scope="col">Solopgang</th>
                        <th scope="col">Dhuhr</th>
                        <th scope="col">Asr</th>
                        <th scope="col">Maghrib</th>
                        <th scope="col">Isha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in Model.Days)
                    {
                        var date = DateOnly.FromDateTime(day.Date);
                        var isToday = date == Model.Today;
                        var prayers = PrayerDay.Events(day, Model.Hanafi);
                        <tr class="@(isToday ? "current-day" : null)" data-calendar-date="@CalendarViewModel.DayParameter(date)"
                            data-today-anchor="calendar-today" id="@(isToday ? "calendar-today" : null)" tabindex="-1">
                            <th scope="row">
                                <time datetime="@CalendarViewModel.DayParameter(date)">@date.ToString("d. MMM", danish)</time>
                                <small data-today-label hidden="@(!isToday)">I dag</small>
                            </th>
                            @for (var i = 0; i < prayers.Count; i++)
                            {
                                @if (i == 1)
                                {
                                    <td>@day.SunriseTime</td>
                                }
                                var prayer = prayers[i];
                                <td>
                                    @if (prayer.StartsAt is { } start)
                                    {
                                        @prayer.Time
                                        @if (DateOnly.FromDateTime(start.Date) != date)
                                        {
                                            <small>Næste døgn</small>
                                        }
                                    }
                                    else
                                    {
                                        <partial name="_BrightNightTime" />
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Model.HasBrightNightTimes)
    {
        <p class="calendar-note">Streger ved Fajr eller Isha betyder, at tidspunktet skal fastsættes efter en metode for lyse nætter. <a asp-action="Method" asp-fragment="lyse-naetter">Læs om lyse nætter</a>.</p>
    }
</section>
