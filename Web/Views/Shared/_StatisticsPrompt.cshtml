@using Web.Controllers
@{
    var statistics = Context.Request.Cookies[HomeController.AnalyticsCookie];
    var currentUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}

@if (statistics is not ("yes" or "no"))
{
    <section class="notice statistics" aria-labelledby="statistics-title">
        <div>
            <h2 id="statistics-title">@T("Besøgsstatistik", "Visitor analytics")</h2>
            <p>@T("Med dit samtykke bruger vi Google Analytics til at se, hvor ofte siden bliver brugt.", "With your consent, we use Google Analytics to see how often the site is used.")
                <a asp-action="Privacy" asp-controller="Home">@T("Læs om privatliv", "Read about privacy")</a>.</p>
        </div>
        <form method="post" asp-controller="Home" asp-action="Statistics" class="actions">
            <input type="hidden" name="returnUrl" value="@currentUrl" />
            <button class="button" name="choice" value="no">@T("Afvis", "Decline")</button>
            <button class="button" name="choice" value="yes">@T("Tillad", "Allow")</button>
        </form>
    </section>
}
