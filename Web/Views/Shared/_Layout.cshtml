@using Web.Controllers
@{
    var statistics = Context.Request.Cookies[HomeController.AnalyticsCookie];
    var offlinePlan = ViewData["OfflinePlan"] is true;
}
<!DOCTYPE html>
<html lang="@T("da", "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#101e1c" />
    <title>@ViewData["Title"] · Salah Times</title>
    @if (!offlinePlan)
    {
        <link rel="icon" href="~/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48" asp-append-version="true" />
    }
    <link rel="icon" href="~/icons/favicon.svg" type="image/svg+xml" sizes="any" asp-append-version="@(!offlinePlan)" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="@(!offlinePlan)" />
    @if (!offlinePlan && statistics == "yes")
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-03RLGPN608"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-03RLGPN608', {
                cookie_domain: 'none',
                cookie_expires: 15552000,
                cookie_update: false,
                page_location: window.location.origin + window.location.pathname,
                allow_google_signals: false,
                allow_ad_personalization_signals: false
            });
        </script>
    }
    @if (!offlinePlan)
    {
        <script defer src="~/js/site.js" asp-append-version="true"></script>
    }
    @if (ViewData["PlaceDataAttribution"] is true)
    {
        <script defer src="~/js/place-picker.js" asp-append-version="true"></script>
    }
</head>
<body>
    <a class="skip-link" href="#indhold">@T("Spring til indhold", "Skip to content")</a>
    <header class="site-header">
        <div class="site-width">
            <a class="brand" href="@Url.Content("~/")">
                <img src="~/icons/crescent.svg" width="22" height="22" alt="" />
                <span>Salah Times</span>
            </a>
            @if (ViewData["TimetableNavigation"] is true)
            {
                if (ViewData["CalendarHasToday"] is true)
                {
                    <a class="header-link mobile-calendar" href="#week-today" data-open-calendar-today>@T("Kalender", "Calendar") <span aria-hidden="true">↓</span></a>
                    <a class="header-link desktop-calendar" href="#month-title">@T("Kalender", "Calendar") <span aria-hidden="true">↓</span></a>
                }
                else
                {
                    <a class="header-link" href="#month-title">@T("Kalender", "Calendar") <span aria-hidden="true">↓</span></a>
                }
            }
            <a class="header-link" asp-action="Language" asp-controller="Home" asp-route-language="@T("en", "da")"
               asp-route-returnUrl="@SwitchTarget(Context.Request)" lang="@T("en", "da")">@T("English", "Dansk")</a>
        </div>
    </header>
    <main class="site-width" id="indhold">
        @RenderBody()
    </main>
    <footer class="site-footer site-width">
        @await RenderSectionAsync("Footer", required: false)
        <a asp-action="Privacy" asp-controller="Home">@T("Privatliv og statistik", "Privacy and analytics")</a>
        @if (ViewData["PlaceDataAttribution"] is true)
        {
            <p class="data-attribution">@T("Steddata fra", "Place data from") <a href="https://www.geonames.org/">GeoNames</a> ·
                <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></p>
        }
    </footer>
</body>
</html>
