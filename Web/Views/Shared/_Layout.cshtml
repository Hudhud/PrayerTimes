@using Web.Controllers
@{
    var statistics = Context.Request.Cookies[HomeController.AnalyticsCookie];
    var currentUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] · Salah Times</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (statistics == "yes")
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-03RLGPN608"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-03RLGPN608', {
                cookie_domain: 'none',
                cookie_expires: 15552000,
                cookie_update: false,
                page_location: window.location.origin + window.location.pathname,
                allow_google_signals: false,
                allow_ad_personalization_signals: false
            });
        </script>
    }
    <script defer src="~/js/site.js" asp-append-version="true"></script>
</head>
<body>
    <a class="skip-link" href="#indhold">Spring til indhold</a>
    <header class="site-header">
        <div class="site-width">
            <a class="brand" href="/">
                <img src="~/icons/crescent.svg" width="22" height="22" alt="" />
                <span>Salah Times</span>
            </a>
        </div>
    </header>
    <main class="site-width" id="indhold">
        @RenderBody()
    </main>
    <footer class="site-footer site-width">
        @if (statistics is not ("yes" or "no"))
        {
            <section class="notice statistics" aria-labelledby="statistics-title">
                <div>
                    <h2 id="statistics-title">Besøgsstatistik</h2>
                    <p>Med dit samtykke bruger vi Google Analytics til at se, hvor ofte siden bliver brugt.
                        <a href="/privatliv">Læs om privatliv</a>.</p>
                </div>
                <form method="post" asp-controller="Home" asp-action="Statistics" class="actions">
                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                    <button class="button" name="choice" value="no">Afvis</button>
                    <button class="button" name="choice" value="yes">Tillad</button>
                </form>
            </section>
        }
        <a href="/privatliv">Privatliv og statistik</a>
    </footer>
</body>
</html>
