@model Web.ViewModels.PrayerListViewModel
@using Application.Calendars
@using System.Globalization
@{
    var date = DateOnly.FromDateTime(Model.Day.Date);
    var prayers = PrayerDay.Events(Model.Day, Model.Hanafi).ToList();
    if (Model.ShowSunrise && Model.InlineSunrise)
    {
        prayers.Insert(1, new PrayerEvent("Solopgang", PrayerDay.Sunrise(Model.Day)));
    }
}
<dl class="prayer-list">
    @foreach (var prayer in prayers)
    {
        var stage = prayer == Model.Current ? "current" : prayer == Model.Next ? "next" : null;
        <div data-prayer-stage="@stage" class="@(prayer.Name == "Solopgang" ? "sunrise-tile" : null)">
            <dt>@prayer.Name</dt>
            <dd>
                @if (prayer.StartsAt is { } start)
                {
                    <time datetime="@start.ToString("o", CultureInfo.InvariantCulture)">@prayer.Time</time>
                    @if (DateOnly.FromDateTime(start.Date) != date)
                    {
                        <small>Næste døgn</small>
                    }
                }
                else if (Model.InlineSunrise)
                {
                    <span aria-hidden="true">—</span>
                    <small class="bright-night-explanation"><a asp-action="Method" asp-fragment="lyse-naetter">Lyse nætter</a></small>
                }
                else if (Model.ExplainBrightNights)
                {
                    <span aria-hidden="true">- -</span>
                    <small class="bright-night-explanation">Solens vinkel nås ikke. <a asp-action="Method" asp-fragment="lyse-naetter">Læs om lyse nætter</a>.</small>
                }
                else
                {
                    <partial name="_BrightNightTime" />
                }
                @if (stage is not null)
                {
                    <small class="prayer-stage prayer-stage-@stage" data-live-stage>@(stage == "current" ? "Nu" : "Næste")</small>
                }
            </dd>
        </div>
    }
</dl>
@if (Model.ShowSunrise && !Model.InlineSunrise)
{
    <p class="sunrise">Solopgang (Shuruk) <time datetime="@Model.Day.SunriseTime">@Model.Day.SunriseTime</time></p>
}
