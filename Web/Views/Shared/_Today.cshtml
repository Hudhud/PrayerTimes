@model Web.ViewModels.DailyPrayerTimesViewModel
@using System.Globalization
@using Web.ViewModels
@{
    var culture = CultureInfo.CurrentCulture;
    var day = Model.Day;
    var next = Model.Next;
    var current = Model.Current;
    var date = CalendarViewModel.DayParameter(Model.Date);
    var correctionUrl = Url.Action("Correction", "Home", new {
        city = Model.City.Slug, date = CalendarViewModel.DayParameter(Model.NextDate ?? Model.Date), prayer = next?.Name
    });
}
<section aria-label="@T("Dagens bønnetider", "Today’s prayer times")" class="today" data-current-place="@Model.City.Slug"
         data-place-name="@Model.City.Name" data-time-zone="@Model.City.TimeZoneId" data-today="@date" data-correction-url="@correctionUrl"
         data-asr-method="@Model.AsrMethod" data-midnight="@Model.Midnight.ToString("o", CultureInfo.InvariantCulture)"
         data-angles="@Model.Angles.PreferenceValue"
         data-refresh-url="@Url.RouteUrl("Today", new { city = Model.City.Slug, asr = Model.AsrMethod, angles = Model.Angles.PreferenceValue })"
         data-rendered-at="@Model.Now.ToString("o", CultureInfo.InvariantCulture)"
         data-refresh-at="@Model.RefreshAt.ToString("o", CultureInfo.InvariantCulture)">
    <div class="next-prayer" data-next-prayer>
        <div>
            <h2 tabindex="-1">@T("Næste bøn", "Next prayer")</h2>
            @if (next?.StartsAt is { } nextStart)
            {
                <p class="next-prayer-title" data-next-prayer-label>
                    <span>@next.Name</span>
                    <time datetime="@nextStart.ToString("o", CultureInfo.InvariantCulture)">@next.Time</time>
                    @if (Model.NextDate is { } nextDate && nextDate != Model.Date)
                    {
                        <span class="next-date">@T("i morgen, ", "tomorrow, ")@nextDate.ToString(T("d. MMMM", "d MMMM"), culture)</span>
                    }
                </p>
                <p class="next-countdown" data-prayer-countdown role="timer" aria-label="@T("Tid til næste bøn", "Time until the next prayer")" hidden></p>
            }
            else if (Model.NextAffectedByBrightNights)
            {
                <p class="next-detail" data-next-prayer-label>@T("Næste bønnetid er ikke tilgængelig.", "The next prayer time is unavailable.") <a asp-action="Method" asp-fragment="lyse-naetter">@T("Læs om manglende tider", "About unavailable times")</a>.</p>
            }
            else
            {
                <p class="next-detail" data-next-prayer-label>@T("Tidspunktet er midlertidigt utilgængeligt.", "The next prayer time is temporarily unavailable.")</p>
            }
        </div>
    </div>
    <p class="today-context">
        <strong data-historical-times hidden>@T("Historiske bønnetider", "Historical prayer times")</strong>
        <time datetime="@date">@Model.Date.ToString(T("dddd d. MMMM yyyy", "dddd d MMMM yyyy"), culture)</time>
        @if (current?.StartsAt?.Date < Model.Date.ToDateTime(TimeOnly.MinValue))
        {
            <span class="prayer-stage prayer-stage-current" data-live-stage>@T("Nu", "Now") · @current.Name</span>
        }
    </p>

    @if (day is null)
    {
        <p><small>Reference @Model.RequestId</small></p>
    }
    else
    {
        <partial name="_PrayerList" model="new PrayerListViewModel(day, Model.Hanafi, ShowSunrise: true, ExplainBrightNights: true, InlineSunrise: true, Current: current, Next: next)" />
    }
</section>
