@model Web.ViewModels.DailyPrayerTimesViewModel
@using System.Globalization
@using Web.ViewModels
@{
    var danish = CultureInfo.GetCultureInfo("da-DK");
    var day = Model.Day;
    var next = Model.Next;
    var date = CalendarViewModel.DayParameter(Model.Date);
    var correctionUrl = Url.Action("Correction", "Home", new {
        city = Model.City.Slug, date = CalendarViewModel.DayParameter(Model.NextDate ?? Model.Date), prayer = next?.Name
    });
}
<section aria-label="Dagens bønnetider" class="today" data-current-place="@Model.City.Slug"
         data-place-name="@Model.City.Name" data-today="@date" data-correction-url="@correctionUrl"
         data-refresh-url="@Url.RouteUrl("Today", new { city = Model.City.Slug })"
         data-rendered-at="@Model.Now.ToString("o", CultureInfo.InvariantCulture)"
         data-refresh-at="@Model.RefreshAt.ToString("o", CultureInfo.InvariantCulture)">
    <p class="today-context">
        <time datetime="@date">@Model.Date.ToString("dddd d. MMMM yyyy", danish)</time>
        <a asp-controller="Home" asp-action="Method">Dansk lokal tid og beregningsmetode</a>
    </p>
    <div class="next-prayer" data-next-prayer>
        <div>
            <h2>Næste bøn</h2>
            @if (next?.StartsAt is not null)
            {
                <p>@next.Name @if (Model.NextDate is { } nextDate && nextDate != Model.Date)
                    {
                        <span class="next-date">i morgen, @nextDate.ToString("d. MMMM", danish)</span>
                    }
                </p>
            }
            else if (Model.NextAffectedByBrightNights)
            {
                <p class="next-detail">Tidspunktet afhænger af metoden for lyse nætter.</p>
            }
            else
            {
                <p class="next-detail">Tidspunktet er midlertidigt utilgængeligt.</p>
            }
        </div>
        @if (next?.StartsAt is { } nextStart)
        {
            <time datetime="@nextStart.ToString("o", CultureInfo.InvariantCulture)">@next.Time</time>
        }
    </div>

    @if (day is null)
    {
        <div class="notice">
            <strong>Dagens bønnetider er midlertidigt utilgængelige.</strong>
            <p>Prøv igen om lidt.</p>
            <p><small>Reference @Model.RequestId</small></p>
        </div>
    }
    else
    {
        <partial name="_PrayerList" model="new PrayerListViewModel(day, Model.Hanafi, ShowSunrise: true)" />
    }
    @if (Model.HasBrightNightTimes || Model.NextAffectedByBrightNights)
    {
        <p class="today-note">
            <strong>Lyse nætter</strong>
            Når Fajr eller Isha står med streger, kan solens vinkel for bønnen ikke nås den nat.
            Følg bønneplanen fra din lokale moské, eller <a asp-action="Method" asp-fragment="lyse-naetter">læs om metoden</a>.
        </p>
    }
</section>
