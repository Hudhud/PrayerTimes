@model Web.ViewModels.CalendarViewModel
@using Web.ViewModels
@if (Model.PreviousMonth is { } previous)
{
    <a class="button" asp-route="City" asp-route-city="@Model.City.Slug" aria-label="@T("Forrige måned", "Previous month")"
       asp-route-month="@CalendarViewModel.MonthParameter(previous)" asp-fragment="month-title">@T("Forrige", "Previous")</a>
}
<a class="button mobile-calendar" asp-route="City" asp-route-city="@Model.City.Slug"
   asp-fragment="week-today" aria-label="@T("Hop til i dag", "Jump to today")" data-open-calendar-today="true">@T("I dag", "Today")</a>
<a class="button desktop-calendar" asp-route="City" asp-route-city="@Model.City.Slug"
   asp-fragment="calendar-today" aria-label="@T("Hop til i dag", "Jump to today")">@T("I dag", "Today")</a>
@if (Model.NextMonth < CalendarViewModel.MonthLimit)
{
    <a class="button" asp-route="City" asp-route-city="@Model.City.Slug" aria-label="@T("Næste måned", "Next month")"
       asp-route-month="@CalendarViewModel.MonthParameter(Model.NextMonth)" asp-fragment="month-title">@T("Næste", "Next")</a>
}
