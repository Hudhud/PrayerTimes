@model Web.ViewModels.CityPrayerTimesViewModel
@using Application.Calendars
@using System.Globalization
@{
    var danish = CultureInfo.GetCultureInfo("da-DK");
    var fullDate = Model.Date.ToString("dddd 'den' d. MMMM yyyy", danish);
    var monthName = Model.Date.ToString("MMMM yyyy", danish);
    var dateParameter = Model.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    ViewData["Title"] = $"Bønnetider i {Model.City.Name}";
    ViewData["PlaceDataAttribution"] = Model.CanSearchPlaces;
    var today = Model.Today;
    var next = Model.Next;
    var nextStart = next?.StartsAt;
    var nextDate = nextStart is { } start ? DateOnly.FromDateTime(start.Date) : Model.Date;
    var midnight = DanishTime.At(Model.Date.AddDays(1), TimeOnly.MinValue);
    var refreshAt = midnight;
    if (nextStart is { } nextTime && nextTime < midnight)
    {
        refreshAt = nextTime;
    }
    else if (nextStart is null && today is not null)
    {
        var sunrise = PrayerDay.Sunrise(today);
        if (Model.Now < sunrise)
        {
            refreshAt = sunrise;
        }
    }
}
@if (Model.CanSearchPlaces)
{
    <partial name="_PlacePicker" model="string.Empty" />
}
else
{
    <nav class="city-nav" aria-label="Vælg by">
        @foreach (var city in PrayerCities.All)
        {
            <a asp-route="City" asp-route-city="@city.Slug"
               aria-current="@(city == Model.City ? "page" : null)">@city.Name</a>
        }
    </nav>
}

<section aria-labelledby="today-title" class="today" data-refresh-at="@refreshAt.ToString("o", CultureInfo.InvariantCulture)">
    <h1 id="today-title">Bønnetider i @Model.City.Name i dag</h1>
    @if (today is not null && next is not null && nextStart is { } nextPrayerTime)
    {
        <div class="next-prayer">
            <div>
                <h2>Næste bøn</h2>
                <p>@next.Name @if (nextDate != Model.Date)
                    {
                        <span class="next-date">i morgen, @nextDate.ToString("d. MMMM", danish)</span>
                    }
                </p>
            </div>
            <time datetime="@nextPrayerTime.ToString("o", CultureInfo.InvariantCulture)">@next.Time</time>
        </div>
    }
    <p class="subtitle"><time datetime="@dateParameter">@fullDate</time></p>
    @if (today is null)
    {
        <div class="notice" role="status">
            <strong>Dagens bønnetider er midlertidigt utilgængelige.</strong>
            <p>Prøv igen om lidt.</p>
            <p><small>Reference @Model.RequestId</small></p>
        </div>
    }
    else
    {
        <dl class="prayer-list">
            @foreach (var prayer in PrayerDay.Events(today))
            {
                <div>
                    <dt>@prayer.Name</dt>
                    <dd>
                        @if (prayer.StartsAt is { } startsAt)
                        {
                            <time datetime="@startsAt.ToString("o", CultureInfo.InvariantCulture)">@prayer.Time</time>
                            @if (DateOnly.FromDateTime(startsAt.Date) != Model.Date)
                            {
                                <small>Næste døgn</small>
                            }
                        }
                        else
                        {
                            <partial name="_BrightNightTime" />
                        }
                    </dd>
                </div>
            }
        </dl>
        <p class="sunrise">Solopgang (Shuruk) <time datetime="@today.SunriseTime">@today.SunriseTime</time></p>
    }
</section>

<section class="month" aria-labelledby="month-title">
    <div class="month-heading">
        <div>
            <h2 id="month-title">@monthName</h2>
            <p class="print-city">@Model.City.Name · Dansk lokal tid</p>
        </div>
        @if (Model.Month.Count > 0)
        {
            <button class="button print-button" type="button" data-print hidden>Udskriv måneden</button>
        }
    </div>
    @if (Model.Month.Count == 0)
    {
        <p>Månedsoversigten er midlertidigt utilgængelig.</p>
    }
    else
    {
        @if (Model.Month.Count != DateTime.DaysInMonth(Model.Date.Year, Model.Date.Month))
        {
            <p>Månedsoversigten er ufuldstændig. Nogle datoer mangler.</p>
        }
        <p class="table-hint">Stryg eller rul vandret for at se hele tabellen.</p>
        <div class="table-scroll" role="region" aria-labelledby="month-title" tabindex="0">
            <table>
                <caption>Bønnetider i @Model.City.Name · @monthName · Dansk lokal tid</caption>
                <thead>
                    <tr>
                        <th scope="col">Dato</th>
                        <th scope="col">Fajr</th>
                        <th scope="col">Solopgang</th>
                        <th scope="col">Dhuhr</th>
                        <th scope="col">Asr</th>
                        <th scope="col">Maghrib</th>
                        <th scope="col">Isha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in Model.Month)
                    {
                        var dayDate = DateOnly.FromDateTime(day.Date);
                        var isToday = dayDate == Model.Date;
                        var ishaNextDay = (day.IshaDayOffset ?? (string.CompareOrdinal(day.IshaTime, day.MaghribTime) < 0 ? 1 : 0)) == 1;
                        <tr class="@(isToday ? "current-day" : null)">
                            <th scope="row">
                                <time datetime="@dayDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@dayDate.ToString("d. MMM", danish)</time>
                                @if (isToday)
                                {
                                    <small>I dag</small>
                                }
                            </th>
                            <td>
                                @if (day.FajrTimeUnavailable)
                                {
                                    <partial name="_BrightNightTime" />
                                }
                                else
                                {
                                    @day.FajrTime
                                }
                            </td>
                            <td>@day.SunriseTime</td>
                            <td>@day.DhuhrTime</td>
                            <td>@day.AsrTime</td>
                            <td>@day.MaghribTime</td>
                            <td>
                                @if (day.UsesPredefinedIshaTime)
                                {
                                    <partial name="_BrightNightTime" />
                                }
                                else
                                {
                                    @day.IshaTime
                                    @if (ishaNextDay)
                                    {
                                        <small>Næste døgn</small>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Model.HasBrightNightTimes)
    {
        <aside class="summer-note" aria-labelledby="summer-note-title">
            <h3 id="summer-note-title">Fajr og Isha under de lyse nætter</h3>
            <p>I en del af sommeren er der så lyst om natten i Danmark, at de tegn, man normalt bruger til at
                fastsætte Fajr og Isha, ikke kan skelnes tydeligt. Når der står <strong>- -</strong>, betyder det,
                at tidspunktet for den pågældende bøn må fastsættes på en anden måde i den periode.</p>
            <p>Der er flere anerkendte holdninger blandt islamiske lærde om, hvordan man fastsætter bønnetiderne
                under de lyse nætter. Du kan følge den bønneplan, din lokale moské anbefaler, eller spørge en lærd,
                du har tillid til, hvilken metode du kan følge.</p>
        </aside>
    }
</section>

@section Footer {
    <p class="correction">
        <a asp-controller="Home" asp-action="Correction"
           asp-route-city="@Model.City.Slug" asp-route-date="@dateParameter"
           asp-route-prayer="@(nextDate == Model.Date ? next?.Name : "Fajr")">Meld en fejl i en bønnetid</a>
    </p>
    <partial name="_StatisticsPrompt" />
}
