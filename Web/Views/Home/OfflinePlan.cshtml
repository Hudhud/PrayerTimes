@model Web.ViewModels.OfflinePrayerTimesViewModel
@using System.Globalization
@using Web.ViewModels
@{
    ViewData["Title"] = T($"Offline bønnetider i {Model.City.Name}", $"Offline prayer times in {Model.City.Name}");
    ViewData["OfflinePlan"] = true;
    var culture = CultureInfo.CurrentCulture;
}

<section class="offline-plan" aria-labelledby="offline-heading">
    <header class="offline-plan-heading">
        <h1 id="offline-heading">@T("Offline bønnetider i ", "Offline prayer times in ")@Model.City.Name</h1>
        <p class="today-context">
            <span><time datetime="@CalendarViewModel.DayParameter(Model.Start)">@Model.Start.ToString(T("d. MMMM yyyy", "d MMMM yyyy"), culture)</time>
                – <time datetime="@CalendarViewModel.DayParameter(Model.End)">@Model.End.ToString(T("d. MMMM yyyy", "d MMMM yyyy"), culture)</time></span>
            <span>@T("Asr-metode", "Asr method") <strong>@(Model.Hanafi ? "Hanafi" : "Standard")</strong></span>
            <span>Fajr @(Model.Angles.Fajr.ToString("0.#", culture))° · Isha @(Model.Angles.Isha.ToString("0.#", culture))°</span>
            <span>@TimeLabel(Model.City)</span>
        </p>
        <a asp-route="City" asp-route-city="@Model.City.Slug">@T("Åbn den aktuelle bønneplan, når du er online", "Open the current timetable when you’re online")</a>
    </header>
    @foreach (var day in Model.Days)
    {
        var date = DateOnly.FromDateTime(day.Date);
        <article class="week-day">
            <h2><time datetime="@CalendarViewModel.DayParameter(date)">@date.ToString(T("dddd d. MMMM", "dddd d MMMM"), culture)</time></h2>
            <partial name="_PrayerList" model="new PrayerListViewModel(day, Model.Hanafi, ShowSunrise: true, ExplainBrightNights: true)" />
        </article>
    }
</section>
