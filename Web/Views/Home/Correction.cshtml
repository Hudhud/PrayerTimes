@model Web.ViewModels.CorrectionViewModel
@using Application.Calendars
@using System.Globalization
@{
    ViewData["Title"] = T("Meld en fejl i en bønnetid", "Report a prayer time error");
    string[] prayers = ["Fajr", "Solopgang", "Dhuhr", "Asr", "Maghrib", "Isha"];
}
<section class="readable">
    <h1>@T("Meld en fejl i en bønnetid", "Report a prayer time error")</h1>
    <p>@T("Din rapport bliver sendt via GitHub, hvor du skal være logget ind. Rapporten bliver offentlig, når du selv indsender den.", "Sign into GitHub to submit your report. It will be public once you submit it.")</p>
    <form method="get" asp-action="Correction" class="report-form">
        <label for="city">@T("By", "City")</label>
        <select id="city" name="city">
            @foreach (var city in PrayerCities.All.Append(Model.City).DistinctBy(city => city.Slug))
            {
                <option value="@city.Slug" selected="@(city == Model.City)">@city.Name</option>
            }
        </select>
        <label for="date">@T("Dato", "Date")</label>
        <input id="date" name="date" type="date" required value="@Model.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        <label for="prayer">@T("Bøn eller solopgang", "Prayer or sunrise")</label>
        <select id="prayer" name="prayer">
            @foreach (var prayer in prayers)
            {
                <option value="@prayer" selected="@(prayer == Model.Prayer)">@(prayer == "Solopgang" ? T("Solopgang", "Sunrise") : prayer)</option>
            }
        </select>
        <button class="button" type="submit" name="open" value="true">@T("Fortsæt til GitHub", "Continue to GitHub")</button>
    </form>
</section>
