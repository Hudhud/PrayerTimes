@model Web.ViewModels.PlaceSearchViewModel
@{
    ViewData["Title"] = T("Find bønnetider", "Find prayer times");
    ViewData["PlaceDataAttribution"] = true;
}

<section class="readable" aria-labelledby="places-title">
    <h1 id="places-title">@T("Find bønnetider", "Find prayer times")</h1>
    <partial name="_PlacePicker" model="Model.Query" />
    @if (Model.Results.Count > 0)
    {
        @if (Model.IsSpellingSuggestion)
        {
            <h2>@T("Mente du?", "Did you mean?")</h2>
        }
        <ul class="place-results">
            @foreach (var place in Model.Results)
            {
                <li>
                    <a asp-route="City" asp-route-city="@place.Id" data-place-result>
                        @place.Label
                        @if (!string.IsNullOrWhiteSpace(place.Area) && place.Area != place.Name)
                        {
                            <small>@place.Area</small>
                        }
                    </a>
                </li>
            }
        </ul>
    }
    else if (Model.Query.Length == 1)
    {
        <p>@T("Skriv mindst to tegn for at søge.", "Enter at least two characters to search.")</p>
    }
    else if (Model.Query.Length > 0)
    {
        <p>@T("Der blev ikke fundet et sted. Prøv et andet bynavn eller postnummer.", "No place found. Try another city or a Danish postcode.")</p>
    }
</section>
